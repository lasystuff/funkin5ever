; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="funkin5ever"
config/version="0.0.1"
run/main_scene="uid://dvdlx4vsl1phr"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dobuvw6gp0yw"
Config="*uid://dpnferl37rk5d"
ContentManager="*uid://djbq3bruhu5op"
Transition="*uid://dy7jbeha3jknu"
GlobalSound="*uid://bo71bsekno06o"
DebugDisplay="*uid://da3817d56yaqc"
Cache="*uid://ip08qtqu07u6"
CustomAutoload="*uid://unbqn0vhmayy"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor]

naming/node_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/camera_preview/plugin.cfg", "res://addons/gdanimate/plugin.cfg", "res://addons/godot_sparrow/plugin.cfg", "res://addons/parallax2d_preview/plugin.cfg", "res://addons/quick_notes_dock/plugin.cfg", "res://addons/spriteframes_keyframer/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "pink",
"res://contents/": "yellow",
"res://core/": "gray"
}

[input]

